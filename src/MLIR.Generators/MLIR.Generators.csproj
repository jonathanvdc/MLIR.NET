<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MLIR.Generators</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <OutputItemType>Analyzer</OutputItemType>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MLIR.ODS\MLIR.ODS.csproj" />
    <ProjectReference Include="..\MLIR\MLIR.csproj" />
    <ProjectReference Include="..\TableGen\TableGen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prelude\mlir\IR\OpBase.td" LogicalName="mlir/IR/OpBase.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\Utils.td" LogicalName="mlir/IR/Utils.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\Constraints.td" LogicalName="mlir/IR/Constraints.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\DialectBase.td" LogicalName="mlir/IR/DialectBase.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\CommonTypeConstraints.td" LogicalName="mlir/IR/CommonTypeConstraints.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\CommonAttrConstraints.td" LogicalName="mlir/IR/CommonAttrConstraints.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\AttrTypeBase.td" LogicalName="mlir/IR/AttrTypeBase.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\Interfaces.td" LogicalName="mlir/IR/Interfaces.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\Properties.td" LogicalName="mlir/IR/Properties.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\Traits.td" LogicalName="mlir/IR/Traits.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\BuiltinAttributeInterfaces.td" LogicalName="mlir/IR/BuiltinAttributeInterfaces.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\OpAsmInterface.td" LogicalName="mlir/IR/OpAsmInterface.td" />
    <EmbeddedResource Include="Prelude\mlir\IR\EnumAttr.td" LogicalName="mlir/IR/EnumAttr.td" />
    <EmbeddedResource Include="Prelude\mlir\Interfaces\CastInterfaces.td" LogicalName="mlir/Interfaces/CastInterfaces.td" />
    <EmbeddedResource Include="Prelude\mlir\Interfaces\ControlFlowInterfaces.td" LogicalName="mlir/Interfaces/ControlFlowInterfaces.td" />
    <EmbeddedResource Include="Prelude\mlir\Interfaces\InferIntRangeInterface.td" LogicalName="mlir/Interfaces/InferIntRangeInterface.td" />
    <EmbeddedResource Include="Prelude\mlir\Interfaces\InferTypeOpInterface.td" LogicalName="mlir/Interfaces/InferTypeOpInterface.td" />
    <EmbeddedResource Include="Prelude\mlir\Interfaces\SideEffectInterfaceBase.td" LogicalName="mlir/Interfaces/SideEffectInterfaceBase.td" />
    <EmbeddedResource Include="Prelude\mlir\Interfaces\SideEffectInterfaces.td" LogicalName="mlir/Interfaces/SideEffectInterfaces.td" />
    <EmbeddedResource Include="Prelude\mlir\Interfaces\VectorInterfaces.td" LogicalName="mlir/Interfaces/VectorInterfaces.td" />
    <EmbeddedResource Include="Prelude\mlir\Dialect\Arith\IR\ArithBase.td" LogicalName="mlir/Dialect/Arith/IR/ArithBase.td" />
    <EmbeddedResource Include="Prelude\mlir\Dialect\Arith\IR\ArithOpsInterfaces.td" LogicalName="mlir/Dialect/Arith/IR/ArithOpsInterfaces.td" />
    <EmbeddedResource Include="Prelude\mlir\Dialect\Arith\IR\ArithOps.td" LogicalName="mlir/Dialect/Arith/IR/ArithOps.td" />
  </ItemGroup>
</Project>
